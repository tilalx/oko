# Frontend build output -- `cd frontend && npm run build` writes straight
# into oko/api/app.py's StaticFiles mount (see frontend/vite.config.ts).
# zones.geojson lives in the same directory but is a committed data file,
# not a build artifact -- not covered by these patterns.
frontend/node_modules/
frontend/dist/
src/oko/api/static/index.html
src/oko/api/static/assets/
